<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Campus Event Management System</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Auth Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.campus.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/student/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
             
    </filter-mapping>

    <!-- Servlets -->
    <servlet><servlet-name>LoginServlet</servlet-name><servlet-class>com.campus.servlet.LoginServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>LoginServlet</servlet-name><url-pattern>/login</url-pattern></servlet-mapping>

    <servlet><servlet-name>RegisterServlet</servlet-name><servlet-class>com.campus.servlet.RegisterServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>RegisterServlet</servlet-name><url-pattern>/register</url-pattern></servlet-mapping>

    <servlet><servlet-name>LogoutServlet</servlet-name><servlet-class>com.campus.servlet.LogoutServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>LogoutServlet</servlet-name><url-pattern>/logout</url-pattern></servlet-mapping>

    <servlet><servlet-name>AdminLoginServlet</servlet-name><servlet-class>com.campus.servlet.AdminLoginServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>AdminLoginServlet</servlet-name><url-pattern>/admin-login</url-pattern></servlet-mapping>

    <servlet><servlet-name>ViewEventsServlet</servlet-name><servlet-class>com.campus.servlet.ViewEventsServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>ViewEventsServlet</servlet-name><url-pattern>/student/events</url-pattern></servlet-mapping>

    <servlet><servlet-name>SearchEventServlet</servlet-name><servlet-class>com.campus.servlet.SearchEventServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>SearchEventServlet</servlet-name><url-pattern>/student/search</url-pattern></servlet-mapping>

    <servlet><servlet-name>EventRegisterServlet</servlet-name><servlet-class>com.campus.servlet.EventRegisterServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>EventRegisterServlet</servlet-name><url-pattern>/student/register-event</url-pattern></servlet-mapping>

    <servlet><servlet-name>CancelRegistrationServlet</servlet-name><servlet-class>com.campus.servlet.CancelRegistrationServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>CancelRegistrationServlet</servlet-name><url-pattern>/student/cancel-registration</url-pattern></servlet-mapping>

    <servlet><servlet-name>MyEventsServlet</servlet-name><servlet-class>com.campus.servlet.MyEventsServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>MyEventsServlet</servlet-name><url-pattern>/student/my-events</url-pattern></servlet-mapping>

    <servlet><servlet-name>FeedbackServlet</servlet-name><servlet-class>com.campus.servlet.FeedbackServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>FeedbackServlet</servlet-name><url-pattern>/student/feedback</url-pattern></servlet-mapping>

    <servlet><servlet-name>AdminDashboardServlet</servlet-name><servlet-class>com.campus.servlet.AdminDashboardServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>AdminDashboardServlet</servlet-name><url-pattern>/admin/dashboard</url-pattern></servlet-mapping>

    <servlet><servlet-name>AddEventServlet</servlet-name><servlet-class>com.campus.servlet.AddEventServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>AddEventServlet</servlet-name><url-pattern>/admin/add-event</url-pattern></servlet-mapping>

    <servlet><servlet-name>UpdateEventServlet</servlet-name><servlet-class>com.campus.servlet.UpdateEventServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>UpdateEventServlet</servlet-name><url-pattern>/admin/update-event</url-pattern></servlet-mapping>

    <servlet><servlet-name>DeleteEventServlet</servlet-name><servlet-class>com.campus.servlet.DeleteEventServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>DeleteEventServlet</servlet-name><url-pattern>/admin/delete-event</url-pattern></servlet-mapping>

    <servlet><servlet-name>ParticipantsServlet</servlet-name><servlet-class>com.campus.servlet.ParticipantsServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>ParticipantsServlet</servlet-name><url-pattern>/admin/participants</url-pattern></servlet-mapping>

    <servlet><servlet-name>ViewFeedbackServlet</servlet-name><servlet-class>com.campus.servlet.ViewFeedbackServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>ViewFeedbackServlet</servlet-name><url-pattern>/admin/view-feedback</url-pattern></servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>
